/* Begin Functions */

// Shared switches / helper callbacks that several vehicles use go here, mirroring
// China-Set-Buses (e.g. its running-cost factor switch and articulated length switches).
//
// No shared functions yet because this GRF has no vehicles. Add them here once vehicle
// files start to reference a common helper, or delete this file and its #include in
// military-pack.pnml if the set grows differently.



switch (FEAT_ROADVEHS, SELF, switch_8_1_length_9, position_in_articulated_veh) {
    0: return 8;
    return 1;
}

switch (FEAT_ROADVEHS, SELF, switch_8_2_length_10, position_in_articulated_veh) {
    0: return 8;
    return 2;
}

