##grflangid 0x01

STR_GRF_NAME        :Rigsing Dragon {VERSION_STRING}
STR_GRF_URL         :TBA
STR_DESC            : 

# 参数（与 src/header.pnml 中的 param 块一起启用）
STR_PARAM_PURCHASE_COST      :购买费用
STR_PARAM_PURCHASE_COST_DESC :调整车辆购买费用。默认为 25%。
STR_PARAM_RUNNING_COST       :运营费用
STR_PARAM_RUNNING_COST_DESC  :调整车辆运营费用。默认为 25%。
STR_PARAM_NUM                :{COMMA}%
STR_PARAM_CARGO_DECAY          :货物贬值周期
STR_PARAM_CARGO_DECAY_DESC  :调整车辆的货物贬值周期。“较长”为“标准”的两倍, “很长”是“较长”的两倍。即使在“标准”设置下, 货物贬值周期也随车辆种类而变化。
STR_PARAM_STANDARD          :标准
STR_PARAM_LONG              :较长
STR_PARAM_VERY_LONG         :很长

# CV
STR_NAME_ZTZ96              :ZTZ-96
STR_NAME_ZSD63              :ZSD-63
STR_NAME_ZTS63A             :ZTS-63A

# TR
STR_NAME_CA10               :解放 CA-10
STR_NAME_SX250              :延安 SX250
STR_NAME_SX2306             :陕汽 SX250

